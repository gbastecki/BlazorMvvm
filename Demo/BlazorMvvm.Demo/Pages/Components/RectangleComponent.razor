@inherits BlazorMvvmComponentBase<RectangleViewModel>
@if (ViewModel == null) return;

<rect @onmousedown:stopPropagation="true"
      @onmousedown="ViewModel.OnMouseDownCommand.Execute"
      width="@RectangleViewModel.RectWidth"
      height="@RectangleViewModel.RectHeight"
      style="cursor:move;"
      fill="red"
      x="@ViewModel.X"
      y="@ViewModel.Y" />