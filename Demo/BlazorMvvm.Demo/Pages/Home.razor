        @* ===== GETTING STARTED ===== *@
        <section id="getting-started" class="demo-section">
            <h2>Getting Started</h2>
            <div class="demo-card">
                <h3>Component Setup</h3>
                <p>Inherit from <code>BlazorMvvmComponentBase&lt;TViewModel&gt;</code> to connect your View and ViewModel.</p>
                <div class="code-tabs">
                    <details open>
                        <summary>With DI (ViewModelFactory)</summary>
                        <pre><code>// ViewModel - register with attribute
[BlazorMvvmViewModel(ViewModelLifetime.Scoped)]
public partial class HomeViewModel : BlazorViewModel
{
    [BlazorObservableProperty]
    private int _counter;
}
// Component - ViewModel auto-injected
public partial class Home : BlazorMvvmComponentBase&lt;HomeViewModel&gt;
{
    protected override void OnInitialized()
    {
        // BaseViewModel is automatically resolved
        // SetDataContext is called automatically
        base.OnInitialized();
    }
}
// Program.cs - register factory
builder.Services.UseBlazorMvvmViewModelFactory();</code></pre>
                    </details>
                    <details>
                        <summary>Manual Setup</summary>
                        <pre><code>// ViewModel - no attributes needed
public class HomeViewModel : BlazorViewModel
{
    private int _counter;
    public int Counter
    {
        get =&gt; _counter;
        set =&gt; Set(ref _counter, value);
    }
}
// Component - manual instantiation
public partial class Home : BlazorMvvmComponentBase&lt;HomeViewModel&gt;
{
    HomeViewModel ViewModel = new();
    protected override void OnInitialized()
    {
        // Must call SetDataContext manually
        SetDataContext(ViewModel);
        base.OnInitialized();
    }
}</code></pre>
                    </details>
                </div>
            </div>
            <div class="demo-card">
                <h3>Razor File</h3>
                <p>The razor markup is the same for both approaches.</p>
                <details>
                    <summary>View Code</summary>
                    <pre><code>@@inherits BlazorMvvmComponentBase&lt;HomeViewModel&gt;
@@page "/"
&lt;div&gt;Counter: @@BaseViewModel.Counter&lt;/div&gt;
&lt;button @@onclick="BaseViewModel.IncrementCommand.Execute"&gt;
    Increment
&lt;/button&gt;</code></pre>
                </details>
            </div>
        </section>
        @* ===== OBSERVABLE PROPERTIES ===== *@
        <section id="observable-properties" class="demo-section">
            <h2>Observable Properties</h2>
            <div class="demo-card">
                <h3>Source-Generated Properties</h3>
                <p>Use <code>[BlazorObservableProperty]</code> to auto-generate properties with change notification.</p>
                <ObservableComponent ViewModel="ObservablePartViewModel">
                    <div class="demo-result">
                        Counter: <strong>@ObservablePartViewModel.Counter</strong>
