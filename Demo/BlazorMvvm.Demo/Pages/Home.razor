        @* ===== COMMANDS ===== *@
        <section id="commands" class="demo-section">
            <h2>Commands</h2>
            <div class="demo-card">
                <h3>Synchronous Command</h3>
                <p>Use <code>[BlazorCommand]</code> to generate commands from methods.</p>
                <div class="demo-result">
                    Counter: <strong>@BaseViewModel.Counter</strong>
                </div>
                <div class="demo-buttons">
                    <button @onclick="() => BaseViewModel.IncreaseCounterCommand.Execute(true)">Increment</button>
                </div>
                <div class="code-tabs">
                    <details>
                        <summary>Source Generation</summary>
                        <pre><code>public partial class MyViewModel : BlazorViewModel
{
    [BlazorObservableProperty]
    private int _counter;
    // Generates: public IBlazorCommand IncrementCommand { get; }
    [BlazorCommand]
    private void Increment() => Counter++;
}</code></pre>
                    </details>
                    <details>
                        <summary>Manual Implementation</summary>
                        <pre><code>public class MyViewModel : BlazorViewModel
{
    private int _counter;
    public int Counter
    {
        get => _counter;
        set => Set(ref _counter, value);
    }
    private IBlazorCommand? _incrementCommand;
    public IBlazorCommand IncrementCommand => 
        _incrementCommand ??= new BlazorCommand(Increment);
    
    private void Increment() => Counter++;
}</code></pre>
                    </details>
                </div>
            </div>
            <div class="demo-card">
                <h3>Async Command with Loading State</h3>
                <p>Use <code>AutoRefreshOnIsExecutingChanged</code> to automatically trigger UI refresh when <code>IsExecuting</code> changes.</p>
                <ObservableComponent ViewModel="ButtonExampleViewModel">
                    <div class="demo-buttons">
                        <button @onclick="ButtonExampleViewModel.DisableButtonCommand.Execute"
                                disabled="@ButtonExampleViewModel.DisableButtonCommand.IsExecuting">
                            @if (ButtonExampleViewModel.DisableButtonCommand.IsExecuting)
                            {
                                <span>Loading... (5s)</span>
                            }
                            else
                            {
                                <span>Click to disable for 5 seconds</span>
                            }
                        </button>
                    </div>
                </ObservableComponent>
                <div class="code-tabs">
                    <details>
                        <summary>Source Generation</summary>
                        <pre><code>public partial class MyViewModel : BlazorViewModel
{
    // Generates command with automatic OnPropertyChanged() callback
    // when IsExecuting changes
    [BlazorCommand(autoRefreshOnIsExecutingChanged: true)]
    private async Task LoadDataAsync()
    {
        await Task.Delay(5000);
    }
}</code></pre>
                    </details>
                    <details>
                        <summary>Manual Implementation</summary>
                        <pre><code>public class MyViewModel : BlazorViewModel, IDisposable
{
    public IBlazorAsyncCommand LoadDataAsyncCommand { get; }
    
    public MyViewModel()
    {
        LoadDataAsyncCommand = new BlazorAsyncCommand(LoadDataAsync)
        {
            ContinueOnCapturedContext = false // Optional: offload continuation to background thread
        };
        LoadDataAsyncCommand.OnIsExecutingChanged += OnExecutingChanged;
    }
    
    private async Task LoadDataAsync() => await Task.Delay(5000);
    
    private void OnExecutingChanged(bool _) => OnPropertyChanged();
    
    public void Dispose() =>
        LoadDataAsyncCommand.OnIsExecutingChanged -= OnExecutingChanged;
}</code></pre>
                    </details>
                </div>
            </div>
            <div class="demo-card">
                <h3>Command with OnIsExecutingChangedCallback</h3>
                <p>Wire up a callback method that is invoked when <code>IsExecuting</code> changes.</p>
                <ObservableComponent ViewModel="MessengerSender">
                    <div class="demo-result">
                        Is Sending: <strong>@MessengerSender.IsSending</strong>
                    </div>
                    <div class="demo-buttons">
                        <button @onclick="MessengerSender.SendMessageCommand.Execute"
                                disabled="@MessengerSender.IsSending">
                            @if (MessengerSender.IsSending)
                            {
                                <span>Sending...</span>
                            }
                            else
                            {
                                <span>Send Message</span>
                            }
                        </button>
                    </div>
                </ObservableComponent>
                <div class="code-tabs">
                    <details>
                        <summary>Source Generation</summary>
                        <pre><code>public partial class MyViewModel : BlazorViewModel
{
    [BlazorObservableProperty]
    private bool _isSending;
    // Callback is wired up automatically
    [BlazorCommand(OnIsExecutingChangedCallback = nameof(OnSendingChanged))]
    private async Task SendMessage()
    {
        await Task.Delay(200);
    }
    private void OnSendingChanged(bool isExecuting)
    {
        IsSending = isExecuting;
    }
}</code></pre>
                    </details>
                    <details>
                        <summary>Manual Implementation</summary>
                        <pre><code>public class MyViewModel : BlazorViewModel, IDisposable
{
    private bool _isSending;
    public bool IsSending
    {
        get => _isSending;
        set => Set(ref _isSending, value);
    }
    
    public IBlazorAsyncCommand SendMessageCommand { get; }
    
    public MyViewModel()
    {
        SendMessageCommand = new BlazorAsyncCommand(SendMessage);
        SendMessageCommand.OnIsExecutingChanged += OnSendingChanged;
    }
    
    private async Task SendMessage() => await Task.Delay(200);
    private void OnSendingChanged(bool isExecuting) => IsSending = isExecuting;
    
    public void Dispose() =>
        SendMessageCommand.OnIsExecutingChanged -= OnSendingChanged;
}</code></pre>
                    </details>
                </div>
            </div>
        </section>
