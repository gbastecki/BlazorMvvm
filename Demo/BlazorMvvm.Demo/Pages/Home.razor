                </ObservableComponent>
                <div class="demo-buttons">
                    <button @onclick="() => ObservablePartViewModel.IncreaseCounterCommand.Execute(true)">Increment (with notify)</button>
                    <button @onclick="() => ObservablePartViewModel.IncreaseCounterCommand.Execute(false)">Increment (silent)</button>
                </div>
                <div class="code-tabs">
                    <details>
                        <summary>Source Generation</summary>
                        <pre><code>public partial class CounterViewModel : BlazorViewModel
{
    [BlazorObservableProperty]
    private int _counter;
    
    // Generates property with change notification
}</code></pre>
                    </details>
                    <details>
                        <summary>Manual Implementation</summary>
                        <pre><code>public class CounterViewModel : BlazorViewModel
{
    private int _counter;
    public int Counter
    {
        get => _counter;
        set => Set(ref _counter, value);
    }
}</code></pre>
                    </details>
                </div>
