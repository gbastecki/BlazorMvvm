        @* ===== MESSENGER ===== *@
        <section id="messenger" class="demo-section">
            <h2>BlazorMessenger</h2>
            <div class="demo-card">
                <h3>Cross-ViewModel Communication</h3>
                <p>Send messages between ViewModels using <code>IBlazorMessenger</code>.</p>
                <div class="messenger-grid">
                    <div>
                        <strong>Sender:</strong>
                        <ObservableComponent ViewModel="MessengerSender">
                            <div class="demo-result">Counter: <strong>@MessengerSender.Counter</strong></div>
                            <button @onclick="MessengerSender.SendMessageCommand.Execute"
                                    disabled="@MessengerSender.IsSending">
                                Send Message
                            </button>
                        </ObservableComponent>
                    </div>
                    <div>
                        <strong>Receiver (auto-registered):</strong>
                        <ObservableComponent ViewModel="MessengerReceiver">
                            <div class="demo-result">
                                Received: <strong>@MessengerReceiver.ReceivedCounter</strong><br />
                                Total: @MessengerReceiver.MessageCount messages<br />
                                @MessengerReceiver.LastMessage
                            </div>
                        </ObservableComponent>
                    </div>
                </div>
                <details>
                    <summary>View Message Code</summary>
                    <pre><code>public class CounterUpdateMessage : ValueChangedMessage&lt;int&gt;
{
    public CounterUpdateMessage(int value) : base(value) { }
}</code></pre>
                </details>
                <div class="code-tabs">
                    <details>
                        <summary>Sender (Source Generation)</summary>
                        <pre><code>// Sender only needs to inject the messenger - no registration needed
public partial class SenderViewModel : BlazorViewModel
{
    private readonly IBlazorMessenger _messenger;
    [BlazorObservableProperty]
    private int _counter;
    // Constructor injection for IBlazorMessenger
    public SenderViewModel(IBlazorMessenger messenger)
    {
        _messenger = messenger;
    }
    [BlazorCommand]
    private void SendMessage()
    {
        Counter++;
        // Send message to all registered recipients
        _messenger.Send(new CounterUpdateMessage(Counter));
    }
}</code></pre>
                    </details>
                    <details>
                        <summary>Sender (Manual)</summary>
                        <pre><code>// Sender only needs to inject the messenger - no registration needed
public class SenderViewModel : BlazorViewModel
{
    private readonly IBlazorMessenger _messenger;
    
    private int _counter;
    public int Counter
    {
        get =&gt; _counter;
        set =&gt; Set(ref _counter, value);
    }
    
    private IBlazorCommand? _sendMessageCommand;
    public IBlazorCommand SendMessageCommand =&gt;
        _sendMessageCommand ??= new BlazorCommand(SendMessage);
    
    // Constructor injection for IBlazorMessenger
    public SenderViewModel(IBlazorMessenger messenger)
    {
        _messenger = messenger;
    }
    
    private void SendMessage()
    {
        Counter++;
        // Send message to all registered recipients
        _messenger.Send(new CounterUpdateMessage(Counter));
    }
}</code></pre>
                    </details>
                </div>
                <div class="code-tabs">
                    <details>
                        <summary>Receiver (Source Generation)</summary>
                        <pre><code>// [BlazorMessenger] generates RegisterMessenger/UnregisterMessenger methods
// Receiver MUST implement IBlazorRecipient&lt;TMessage&gt; for each message type
[BlazorMessenger]
public partial class ReceiverViewModel : BlazorViewModel, 
    IBlazorRecipient&lt;CounterUpdateMessage&gt;, IDisposable
{
    private readonly IBlazorMessenger _messenger;
    [BlazorObservableProperty]
    private int _receivedCounter;
    // Register in constructor - starts listening for messages
    public ReceiverViewModel(IBlazorMessenger messenger)
    {
        _messenger = messenger;
        RegisterMessenger(_messenger); // Generated method
    }
    // Unregister in Dispose - stops listening, prevents memory leaks
    public void Dispose()
    {
        UnregisterMessenger(_messenger); // Generated method
    }
    // Called when CounterUpdateMessage is received
    public void Receive(CounterUpdateMessage message)
    {
        ReceivedCounter = message.Value;
    }
}</code></pre>
                    </details>
                    <details>
                        <summary>Receiver (Manual)</summary>
                        <pre><code>// Receiver MUST implement IBlazorRecipient&lt;TMessage&gt; for each message type
public class ReceiverViewModel : BlazorViewModel, 
    IBlazorRecipient&lt;CounterUpdateMessage&gt;, IDisposable
{
    private readonly IBlazorMessenger _messenger;
    
    private int _receivedCounter;
    public int ReceivedCounter
    {
        get =&gt; _receivedCounter;
        set =&gt; Set(ref _receivedCounter, value);
    }
    // Register in constructor - starts listening for messages
    public ReceiverViewModel(IBlazorMessenger messenger)
    {
        _messenger = messenger;
        // Register for each message type manually
        _messenger.Register&lt;CounterUpdateMessage&gt;(this);
    }
    // Unregister in Dispose - stops listening, prevents memory leaks
    public void Dispose()
    {
        // Unregister from each message type
        _messenger.Unregister&lt;CounterUpdateMessage&gt;(this);
    }
    // Called when CounterUpdateMessage is received
    public void Receive(CounterUpdateMessage message)
    {
        ReceivedCounter = message.Value;
    }
}</code></pre>
                    </details>
                </div>
            </div>
            <div class="demo-card">
                <h3>Messenger Setup</h3>
                <p>Choose between Dependency Injection or static singleton access.</p>
                <div class="code-tabs">
                    <details>
                        <summary>Dependency Injection (Recommended)</summary>
                        <pre><code>// Program.cs - Register messenger as singleton
builder.Services.AddSingleton&lt;IBlazorMessenger, BlazorMessenger&gt;();
// ViewModel - Inject via constructor
public class MyViewModel : BlazorViewModel
{
    private readonly IBlazorMessenger _messenger;
    
    public MyViewModel(IBlazorMessenger messenger)
    {
        _messenger = messenger;
    }
    
    public void SendNotification() =&gt;
        _messenger.Send(new NotificationMessage("Hello!"));
}</code></pre>
                    </details>
                    <details>
                        <summary>Static Singleton</summary>
                        <pre><code>// No registration needed - use static Default property
public class MyViewModel : BlazorViewModel
{
    public void SendNotification()
    {
        // Access singleton directly - useful for static contexts
        BlazorMessenger.Default.Send(new NotificationMessage("Hello!"));
    }
}
// Receiver using static singleton
public class ReceiverViewModel : BlazorViewModel, 
    IBlazorRecipient&lt;NotificationMessage&gt;, IDisposable
{
    public ReceiverViewModel()
    {
        BlazorMessenger.Default.Register&lt;NotificationMessage&gt;(this);
    }
    
    public void Dispose() =&gt;
        BlazorMessenger.Default.Unregister&lt;NotificationMessage&gt;(this);
    
    public void Receive(NotificationMessage message) { }
}</code></pre>
                    </details>
                </div>
            </div>
            <div class="demo-card">
                <h3>Strong Reference Messenger</h3>
                <p>Use <code>BlazorStrongMessenger</code> when you need guaranteed message delivery and explicit lifecycle control.</p>
                <div class="code-tabs">
                    <details>
                        <summary>Registration &amp; Usage</summary>
                        <pre><code>// Program.cs - Use strong messenger instead of weak
builder.Services.AddSingleton&lt;IBlazorMessenger, BlazorStrongMessenger&gt;();
// Or use static singleton
BlazorStrongMessenger.Default.Send(new MyMessage());</code></pre>
                    </details>
                    <details>
                        <summary>Weak vs Strong References</summary>
                        <pre><code>// BlazorMessenger (default) - WEAK references
// - Recipients can be garbage collected even if still registered
// - Safer for long-lived messengers with short-lived recipients
// - Forgetting to unregister won't cause memory leaks
// BlazorStrongMessenger - STRONG references  
// - Recipients kept alive until explicitly unregistered
// - Guaranteed message delivery while registered
// - MUST call Unregister/Dispose to prevent memory leaks
// WARNING: With BlazorStrongMessenger, always implement IDisposable
public class ReceiverViewModel : BlazorViewModel, 
    IBlazorRecipient&lt;MyMessage&gt;, IDisposable
{
    public ReceiverViewModel(IBlazorMessenger messenger)
    {
        messenger.Register&lt;MyMessage&gt;(this);
    }
    
    // CRITICAL: Must unregister to avoid memory leaks!
    public void Dispose() =&gt;
        messenger.Unregister&lt;MyMessage&gt;(this);
    
    public void Receive(MyMessage message) { }
}</code></pre>
                    </details>
                </div>
            </div>
            <div class="demo-card">
                <h3>Channel-based Messaging</h3>
                <p>Use tokens to create isolated communication channels. Only recipients registered on a channel receive messages sent to that channel.</p>
                <div class="code-tabs">
                    <details>
                        <summary>String Channels</summary>
                        <pre><code>// Define channel tokens (any IEquatable&lt;T&gt; type works)
public static class Channels
{
    public const string Primary = "Primary";
    public const string Secondary = "Secondary";
}
// Register receiver on a specific channel
public ReceiverViewModel(IBlazorMessenger messenger)
{
    // Only receives messages sent to "Primary" channel
    messenger.Register&lt;MyMessage, string&gt;(this, Channels.Primary,
        (recipient, message) =&gt; ((ReceiverViewModel)recipient).OnMessage(message));
}
// Send message to specific channel
_messenger.Send(new MyMessage(), Channels.Primary);   // Received
_messenger.Send(new MyMessage(), Channels.Secondary); // NOT received</code></pre>
                    </details>
                    <details>
                        <summary>Enum Channels (via int)</summary>
                        <pre><code>// Define enum for readable channel identifiers
// Note: Enums don't implement IEquatable&lt;T&gt; by default,
// so cast to int when using as tokens
public enum NotificationChannel
{
    System = 0,
    User = 1,
    Debug = 2
}
public class LogViewModel : BlazorViewModel, 
    IBlazorRecipient&lt;LogMessage&gt;, IDisposable
{
    private readonly IBlazorMessenger _messenger;
    
    public LogViewModel(IBlazorMessenger messenger)
    {
        _messenger = messenger;
        // Register for Debug channel only (cast enum to int)
        _messenger.Register&lt;LogMessage, int&gt;(
            this, 
            (int)NotificationChannel.Debug,
            (r, m) =&gt; ((LogViewModel)r).Receive(m));
    }
    
    public void Dispose() =&gt;
        _messenger.Unregister&lt;LogMessage, int&gt;(
            this, (int)NotificationChannel.Debug);
    
    public void Receive(LogMessage message)
    {
        Console.WriteLine($"[DEBUG] {message.Text}");
    }
}
// Send to specific channel (cast enum to int)
_messenger.Send(new LogMessage("System starting"), (int)NotificationChannel.System);
_messenger.Send(new LogMessage("User clicked"), (int)NotificationChannel.User);
_messenger.Send(new LogMessage("Variable x = 5"), (int)NotificationChannel.Debug);</code></pre>
                    </details>
                    <details>
                        <summary>With Source Generation</summary>
                        <pre><code>// Note: [BlazorMessenger] attribute currently generates registration
// for the default channel only. For channel-specific registration,
// combine generated methods with manual channel registration:
[BlazorMessenger]
public partial class MultiChannelReceiver : BlazorViewModel,
    IBlazorRecipient&lt;AlertMessage&gt;, IDisposable
{
    private readonly IBlazorMessenger _messenger;
    
    public MultiChannelReceiver(IBlazorMessenger messenger)
    {
        _messenger = messenger;
        
        // Register on default channel (via generated method)
        RegisterMessenger(_messenger);
        
        // Additionally register on specific channels (manual)
        _messenger.Register&lt;AlertMessage, string&gt;(
            this, "HighPriority",
            (r, m) =&gt; ((MultiChannelReceiver)r).Receive(m));
    }
    
    public void Dispose()
    {
        UnregisterMessenger(_messenger);
        _messenger.Unregister&lt;AlertMessage, string&gt;(this, "HighPriority");
    }
    
    public void Receive(AlertMessage message) { }
}</code></pre>
                    </details>
                </div>
            </div>
        </section>
        @* ===== VIEWMODEL FACTORY ===== *@
        <section id="viewmodel-factory" class="demo-section">
            <h2>ViewModelFactory</h2>
            <div class="demo-card">
                <h3>Dependency Injection</h3>
                <p>Register ViewModels with <code>[BlazorMvvmViewModel]</code> for automatic DI.</p>
                <details>
                    <summary>View Registration Code</summary>
                    <pre><code>// Program.cs
builder.Services.UseBlazorMvvmViewModelFactory();
// ViewModel with lifetime
[BlazorMvvmViewModel(ViewModelLifetime.Singleton)]
public class HomeViewModel : BlazorViewModel
{
    private readonly IService _service;
    
    public HomeViewModel(IService service) 
    {
        _service = service;
    }
    // Constructor selection
    [BlazorMvvmViewModelFactoryConstructor]
    public HomeViewModel(IService service, ILogger logger) { }
}
</code></pre>
                </details>
                <details>
                    <summary>View Component Code</summary>
                    <pre><code>// ViewModel auto-injected via BaseViewModel property
public partial class Home : BlazorMvvmComponentBase&lt;HomeViewModel&gt;
{
    protected override void OnInitialized()
    {
        // No manual SetDataContext needed!
        // BaseViewModel is automatically resolved and set.
        base.OnInitialized();
    }
}</code></pre>
                </details>
            </div>
            <div class="demo-card">
                <h3>Lifetime Options</h3>
                <ul>
                    <li><code>Transient</code> - Created every time (default)</li>
                    <li><code>Scoped</code> - Created once per scope</li>
                    <li><code>Singleton</code> - Created once per application</li>
                </ul>
            </div>
        </section>
        @* ===== SVG PERFORMANCE DEMO ===== *@
        <section id="performance" class="demo-section">
            <h2>Performance Demo</h2>
            <div class="demo-card">
                <h3>Draggable Rectangles</h3>
                <p>Create rectangles and drag them. Motion is smooth due to selective re-rendering.</p>
                <div class="demo-buttons">
                    <button @onclick="SvgWrapperViewModel.CreateRectanglesCommand.Execute"
                            disabled="@SvgWrapperViewModel.CreateRectanglesCommand.IsExecuting">
                        Create 10,000 Rectangles
                    </button>
                </div>
                <ObservableComponent ViewModel="SvgWrapperViewModel">
                    <div class="svg-container">
                        <svg @ref="SvgWrapperViewModel.SvgRef"
                             viewBox="0 0 @SvgWrapperViewModel.SvgMaxX @SvgWrapperViewModel.SvgMaxY"
                             @onmousemove="SvgWrapperViewModel.OnSvgMouseMoveCommand.Execute"
                             @onmouseup="SvgWrapperViewModel.OnSvgMouseUpCommand.Execute"
                             @onmouseleave="SvgWrapperViewModel.OnSvgMouseLeaveCommand.Execute">
                            @foreach (var rect in SvgWrapperViewModel.Rectangles)
                            {
                                <BlazorMvvm.Demo.Pages.Components.RectangleComponent ViewModel="rect" />
                            }
                        </svg>
                    </div>
                </ObservableComponent>
            </div>
        </section>
        @* ===== DEBOUNCED REFRESHING ===== *@
        <section id="debounce" class="demo-section">
            <h2>Debounced Refreshing</h2>
            <div class="demo-card">
                <h3>Text Search Debouncing</h3>
                <p>Type in the input box below. The statistics (character count and reversed text) are debounced and only recalculate after you stop typing for 400ms.</p>
                <ObservableComponent ViewModel="DebounceExampleViewModel">
                    <div class="demo-interactive">
                        <div class="form-group" style="margin-bottom: 20px;">
                            <label for="debounce-input" style="font-weight: 600; display: block; margin-bottom: 8px;">Search Input</label>
                            <input id="debounce-input" type="text"
                                   value="@DebounceExampleViewModel.SearchText"
                                   @oninput="@((ChangeEventArgs e) => DebounceExampleViewModel.SearchText = e.Value?.ToString() ?? string.Empty)"
                                   placeholder="Type something to see debounce in action..."
                                   class="form-control"
                                   style="width: 100%; padding: 10px 14px; border: 1px solid var(--border); border-radius: 6px; background-color: var(--card-bg); color: var(--text-color);" />
                        </div>
                        <div class="demo-stats" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 20px;">
                            <div class="stat-box" style="padding: 16px; border: 1px solid var(--border); border-radius: 8px; background: rgba(255,255,255,0.02);">
                                <span class="stat-label" style="font-size: 0.85rem; color: var(--text-muted); display: block; margin-bottom: 4px;">Instant Property (SearchText)</span>
                                <span class="stat-value" style="font-size: 1.25rem; font-weight: 700; color: #ffca28; word-break: break-all; min-height: 1.5em; display: inline-block;">@DebounceExampleViewModel.SearchText</span>
                            </div>
                            <div class="stat-box" style="padding: 16px; border: 1px solid var(--border); border-radius: 8px; background: rgba(255,255,255,0.02);">
                                <span class="stat-label" style="font-size: 0.85rem; color: var(--text-muted); display: block; margin-bottom: 4px;">Debounced (Character Count)</span>
                                <span class="stat-value" style="font-size: 1.25rem; font-weight: 700; color: #42a5f5; min-height: 1.5em; display: inline-block;">@DebounceExampleViewModel.CharacterCount</span>
                            </div>
                            <div class="stat-box" style="padding: 16px; border: 1px solid var(--border); border-radius: 8px; background: rgba(255,255,255,0.02);">
                                <span class="stat-label" style="font-size: 0.85rem; color: var(--text-muted); display: block; margin-bottom: 4px;">Debounced (Reversed Text)</span>
                                <span class="stat-value" style="font-size: 1.25rem; font-weight: 700; color: #66bb6a; word-break: break-all; min-height: 1.5em; display: inline-block;">@DebounceExampleViewModel.ReversedText</span>
                            </div>
                        </div>
                    </div>
                </ObservableComponent>
                <div class="code-tabs">
                    <details open>
                        <summary>ViewModel Implementation</summary>
                        <pre><code>public class DebounceExampleViewModel : BlazorViewModel, IDisposable
{
    private string _searchText = string.Empty;

    public string SearchText
    {
        get => _searchText;
        set
        {
            if (_searchText == value) return;
            _searchText = value;

            // Debounce the full refresh for 400ms to update dependent properties
            DebounceRefresh(400, null);
        }
    }

    public int CharacterCount => _searchText.Length;
    public string ReversedText
    {
        get
        {
            char[] arr = _searchText.ToCharArray();
            System.Array.Reverse(arr);
            return new string(arr);
        }
    }

    public void Dispose()
    {
        base.CancelAllDebounces();
        GC.SuppressFinalize(this);
    }
}</code></pre>
                    </details>
                    <details>
                        <summary>Razor View Markup</summary>
                        <pre><code>&lt;input value="@@DebounceExampleViewModel.SearchText" 
       @@oninput="@@((ChangeEventArgs e) =&gt; DebounceExampleViewModel.SearchText = e.Value?.ToString())" /&gt;

&lt;p&gt;Instant: @@DebounceExampleViewModel.SearchText&lt;/p&gt;
&lt;p&gt;Character Count: @@DebounceExampleViewModel.CharacterCount&lt;/p&gt;
&lt;p&gt;Reversed: @@DebounceExampleViewModel.ReversedText&lt;/p&gt;</code></pre>
                    </details>
                </div>
            </div>
        </section>
